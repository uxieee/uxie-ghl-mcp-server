{
  "name": "ghl-mcp-server",
  "account_id": "3ce79708257fa1c3646f3c1ca491fe9b",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // v1 must stay: the deployed script records its migration tag, and wrangler
  // re-sends the whole array if the recorded tag is missing from config.
  // v2 deletes the class and every instance's storage — ~47,060 abandoned
  // per-session Durable Objects, ~4.97 GB, left behind by the McpAgent
  // session model that `createMcpHandler` replaced. Nothing routes to the
  // class any more, and nothing was ever stored in it beyond empty SDK schema.
  "migrations": [
    { "new_sqlite_classes": ["GHLServer"], "tag": "v1" },
    { "deleted_classes": ["GHLServer"], "tag": "v2" }
  ]
}
